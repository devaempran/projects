# API Keys
POLYGON_API_KEY=your_polygon_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
NEWS_API_KEY=your_news_api_key_here

# Database
DATABASE_URL=postgresql://trading_user:trading_pass@localhost:5432/trading_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Trading Configuration
MARKET_OPEN_TIME=09:30:00
MARKET_CLOSE_TIME=16:00:00
TRADING_WINDOW_MINUTES=10
TIMEZONE=America/New_York

# Risk Parameters
MAX_POSITION_SIZE=10000
MAX_PORTFOLIO_EXPOSURE=0.3
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.03

# Watchlist (comma-separated)
WATCHLIST=AAPL,MSFT,GOOGL,AMZN,TSLA,NVDA,META,JPM,V,WMT

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/platform.log

# Dashboard
DASHBOARD_PORT=8501
DASHBOARD_REFRESH_SECONDS=5

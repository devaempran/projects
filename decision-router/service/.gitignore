.venv/
__pycache__/
*.pyc
models/
bench/models/
*.log
*.err

# Benchmark output: the large per-item rows (cfg_*.json, k_*.json, about 30 MB) are regenerated by
# bench/run_all.sh. Plots, summaries and the key evaluation rows are committed.
bench/results/*
!bench/results/plots/
!bench/results/p1_*.json
!bench/results/p2*.json
!bench/results/report*.json
!bench/results/escalation_*.json
!bench/results/load_*.json
!bench/results/xd_*.json
!bench/results/think_*.jsonl
!bench/results/notsure_results.json
!bench/results/decide_test.jsonl
